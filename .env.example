# Sala de Controlo — variáveis de ambiente (nunca commitar valores reais).
# Configure os valores verdadeiros na plataforma de alojamento (Vercel →
# Project → Settings → Environment Variables), nunca neste ficheiro.

# Código de acesso à Sala de Controlo.
CONTROL_ROOM_ACCESS_CODE=

# Segredo usado para assinar a sessão e o contador de tentativas (gere um
# valor aleatório forte, por exemplo: openssl rand -base64 32).
SESSION_SECRET=

# Transporte Escolar
SCHOOL_TRANSPORT_USERNAME=
SCHOOL_TRANSPORT_PASSWORD=

# Transporte BMM
BMM_USERNAME=
BMM_PASSWORD=

# Transportes Municipais (mesmas credenciais para Gestão de Activos e Relatórios)
MUNICIPAL_USERNAME=
MUNICIPAL_PASSWORD=

# Transporte Intermodal
INTERMODAL_USERNAME=
INTERMODAL_PASSWORD=
